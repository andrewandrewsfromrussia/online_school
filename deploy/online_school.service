[Unit]
Description=Online School Django app (Gunicorn)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy

WorkingDirectory=/opt/online_school
EnvironmentFile=/opt/online_school/.env

ExecStart=/opt/online_school/.venv/bin/gunicorn config.wsgi:application \
  --config /opt/online_school/deploy/gunicorn.conf.py

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
